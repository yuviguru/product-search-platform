# Airtable Configuration
# Get your Personal Access Token from: https://airtable.com/create/tokens
# Get your Base ID from the Airtable URL: airtable.com/appXXXXXXXXX/...
# Table name is usually "Products" or your custom table name

VITE_AIRTABLE_PAT=pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
VITE_AIRTABLE_TABLE_NAME=Products
